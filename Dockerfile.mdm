# syntax=docker/dockerfile:1
# kidwatch-mdm: wlasny serwer MDM, osobny obraz i osobny pod obok kidwatch.
# Te same bazy i piny co Dockerfile (uzasadnienie pinow tam).
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim@sha256:e5b65587bce7de595f299855d7385fe7fca39b8a74baa261ba1b7147afa78e58 AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev


FROM python:3.12-slim-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends tini ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 10001 kidwatch \
 && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin kidwatch

WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    KIDWATCH_MDM_DATA=/data \
    KIDWATCH_MDM_SCHEMA=/app/apple_schema_index.json \
    KIDWATCH_MDM_HEARTBEAT=/tmp/kidwatch-mdm-heartbeat

COPY --from=builder --chown=10001:10001 /app/.venv /app/.venv
COPY --chown=10001:10001 src ./src
# Schemat Apple w obrazie: polityka z nieznanym kluczem nie wystartuje.
COPY --chown=10001:10001 tools/apple_schema_index.json ./apple_schema_index.json

RUN mkdir -p /data && chown 10001:10001 /data
VOLUME ["/data"]
USER 10001:10001

EXPOSE 8080 8081
HEALTHCHECK --interval=60s --timeout=5s --start-period=60s --retries=3 \
    CMD python -c "import os,sys,time; p=os.environ['KIDWATCH_MDM_HEARTBEAT']; \
sys.exit(0 if os.path.exists(p) and time.time()-os.path.getmtime(p) < 120 else 1)"

ENTRYPOINT ["/usr/bin/tini", "--", "python", "-m", "kidwatch_mdm"]
CMD ["run"]
